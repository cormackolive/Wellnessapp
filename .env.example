# Copy this file to .env and fill in your values. .env is gitignored.

# --- Supabase (required) ---
# Project Settings > API in your Supabase dashboard.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- AI concierge / meal analysis (optional but recommended) ---
# Server-side only. Set as a Supabase Edge Function secret, NOT an EXPO_PUBLIC_
# var — it must never ship in the mobile bundle.
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# Without this, the app falls back to the mock AI provider automatically.
ANTHROPIC_API_KEY=

# --- Places / nearby discovery (optional) ---
# Leave blank to use the mock places provider (seeded Supabase restaurant &
# activity data). See src/lib/places/mapboxProvider.ts for what's needed to
# go live.
EXPO_PUBLIC_MAPBOX_TOKEN=

# --- Payments (optional) ---
# RevenueCat PUBLIC per-platform SDK keys (appl_... / goog_...) — NOT the
# secret REST key. Leave blank to use the mock payments provider (backed by
# the Supabase `subscriptions` table). See src/lib/payments/revenuecatProvider.ts.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Server-side only, for a future webhook handler reconciling RevenueCat
# entitlement events into Supabase. Never used client-side.
#   supabase secrets set REVENUECAT_SECRET_KEY=sk_...
REVENUECAT_SECRET_KEY=
